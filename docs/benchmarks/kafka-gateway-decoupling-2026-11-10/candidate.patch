+// Async items release their caller reference after enqueue. The sender keeps
+// ownership until completion, including cancellation and late responses.
+func (r *replyRouter) enqueueForwardAsync(ctx context.Context, endpoint, instance string, expires int64, data []byte, done func(int)) {
+	item := r.forwardItems.Load().acquire(ctx, batchMessage{instance, expires, data})
