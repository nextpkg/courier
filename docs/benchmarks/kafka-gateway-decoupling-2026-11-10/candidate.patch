diff --git a/transport/kafka/router_async.go b/transport/kafka/router_async.go
new file mode 100644
--- /dev/null
+++ b/transport/kafka/router_async.go
@@ -0,0 +1,84 @@
+package kafka
+
+import (
+	"context"
+	"github.com/twmb/franz-go/pkg/kgo"
+	"time"
+)
+
+// forwardAsync performs validation on the consumer worker and lets batch
+// completion finish the retained window entry. Only transient failures fall
+// back to a waiting goroutine; these too are bounded by the same window.
+func (r *replyRouter) forwardAsync(ctx context.Context, record *kgo.Record, done func(error)) {
+	f, view, ok := r.prepareForward(record)
+	if !ok {
+		done(nil)
+		return
+	}
+	if f.Endpoint == r.endpoint || r.opts.BatchSize <= 1 {
+		done(r.forwardPrepared(ctx, record, f, view))
+		return
+	}
+	if ctx.Err() != nil {
+		done(ctx.Err())
+		return
+	}
+	until := time.Unix(0, f.Expires)
+	if bound := time.Now().Add(r.opts.MaxReplyAge); until.After(bound) {
+		until = bound
+	}
+	if !time.Now().Before(until) {
+		r.expired.Add(1)
+		done(nil)
+		return
+	}
+	r.mu.Lock()
+	stale := r.stale[f.Instance]
+	r.mu.Unlock()
+	if stale > time.Now().UnixNano() {
+		r.staleHits.Add(1)
+		done(nil)
+		return
+	}
+	life, cancel := context.WithDeadline(ctx, until)
+	finish := func(err error) { cancel(); done(err) }
+	expired := func() {
+		if ctx.Err() != nil {
+			finish(ctx.Err())
+		} else {
+			r.expired.Add(1)
+			finish(nil)
+		}
+	}
+	r.enqueueForwardAsync(life, f.Endpoint, f.Instance, f.Expires, record.Value, func(status int) {
+		if ctx.Err() != nil {
+			finish(ctx.Err())
+			return
+		}
+		if r.finishForward(f, status) {
+			finish(nil)
+			return
+		}
+		if life.Err() != nil {
+			expired()
+			return
+		}
+		r.retries.Add(1)
+		go func() {
+			timer := time.NewTimer(25 * time.Millisecond)
+			defer timer.Stop()
+			select {
+			case <-life.Done():
+				expired()
+				return
+			case <-timer.C:
+			}
+			err := r.forwardPrepared(life, record, f, view)
+			if err != nil && life.Err() != nil && ctx.Err() == nil {
+				expired()
+				return
+			}
+			finish(err)
+		}()
+	})
+}
