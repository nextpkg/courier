@@ -0,0 +1,149 @@
+package kafka
+
+import (
+	"context"
+	"errors"
+	"github.com/twmb/franz-go/pkg/kgo"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestAsyncForwardRetainsCommitGapAndClearsCallback(t *testing.T) {
+	r, f, b := routerFixture(t)
+	r.opts.BatchSize = 32
+	r.opts.BatchConcurrency = 2
+	r.forwardItems.Store(newForwardItemPool(8))
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	r.t.ctx = ctx
+	release := make(chan struct{})
+	started := make(chan struct{})
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		_, _ = io.ReadAll(req.Body)
+		close(started)
+		select {
+		case <-release:
+		case <-ctx.Done():
+			return
+		}
+		_, _ = w.Write(encodeBinaryStatuses([]int{204}))
+	}))
+	defer srv.Close()
+	defer func() {
+		select {
+		case <-release:
+		default:
+			close(release)
+		}
+	}()
+	r.client = srv.Client()
+	f.Endpoint = srv.URL
+	f.Expires = time.Now().Add(2 * time.Second).UnixNano()
+	raw, _ := marshalForwardRoute(f)
+	record := &kgo.Record{Topic: f.Topic, Value: b, Headers: []kgo.RecordHeader{{Key: routeHeader, Value: raw}}}
+	window := newWindow()
+	first := window.add(record)
+	second := window.add(&kgo.Record{Topic: f.Topic, Offset: 1})
+	done := make(chan error, 1)
+	dispatched := make(chan struct{})
+	go func() { r.forwardAsync(ctx, record, func(err error) { done <- err }); close(dispatched) }()
+	select {
+	case <-dispatched:
+	case <-ctx.Done():
+		t.Fatal("worker retained while waiting for remote completion")
+	}
+	select {
+	case <-started:
+	case <-ctx.Done():
+		t.Fatal("batch never started")
+	}
+	select {
+	case err := <-done:
+		t.Fatalf("acknowledged before target responded: %v", err)
+	default:
+	}
+	window.complete(completion{second, nil})
+	if records, _ := window.prefixes(); len(records) != 0 {
+		t.Fatal("offset advanced across unfinished async entry")
+	}
+	close(release)
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+		window.complete(completion{first, err})
+	case <-ctx.Done():
+		t.Fatal(ctx.Err())
+	}
+	if records, counts := window.prefixes(); len(records) != 1 || records[0].Offset != 1 || counts[0] != 2 {
+		t.Fatal("successful completion did not release contiguous prefix")
+	}
+	r.batchWG.Wait()
+	item := <-r.forwardItems.Load().idle
+	if item.onComplete != nil || item.ctx != nil || item.message.Data != nil {
+		t.Fatal("pool retained callback or borrowed input")
+	}
+}
+
+func TestAsyncForwardRetryExpiryAndCancellation(t *testing.T) {
+	for _, mode := range []string{"retry", "expire", "cancel"} {
+		t.Run(mode, func(t *testing.T) {
+			r, f, b := routerFixture(t)
+			r.opts.BatchSize = 32
+			r.forwardItems.Store(newForwardItemPool(8))
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			r.t.ctx = ctx
+			var calls atomic.Int32
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+				_, _ = io.ReadAll(req.Body)
+				n := calls.Add(1)
+				if mode == "cancel" {
+					cancel()
+				}
+				if mode != "retry" || n == 1 {
+					w.WriteHeader(503)
+					return
+				}
+				_, _ = w.Write(encodeBinaryStatuses([]int{204}))
+			}))
+			defer srv.Close()
+			r.client = srv.Client()
+			f.Endpoint = srv.URL
+			f.Expires = time.Now().Add(100 * time.Millisecond).UnixNano()
+			raw, _ := marshalForwardRoute(f)
+			record := &kgo.Record{Topic: f.Topic, Value: b, Headers: []kgo.RecordHeader{{Key: routeHeader, Value: raw}}}
+			done := make(chan error, 2)
+			r.forwardAsync(ctx, record, func(err error) { done <- err })
+			select {
+			case err := <-done:
+				if mode == "cancel" {
+					if !errors.Is(err, context.Canceled) {
+						t.Fatalf("unfinished reply acknowledged: %v", err)
+					}
+				} else if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(3 * time.Second):
+				t.Fatal("callback did not terminate")
+			}
+			r.batchWG.Wait()
+			select {
+			case <-done:
+				t.Fatal("duplicate completion")
+			default:
+			}
+			if mode == "retry" && (calls.Load() < 2 || r.forwarded.Load() != 1 || r.t.readRecords.Load() != 1) {
+				t.Fatal("retry lost delivery or counted record twice")
+			}
+			if mode == "expire" && r.expired.Load() != 1 {
+				t.Fatal("expiry must allow terminal completion exactly once")
+			}
+		})
+	}
+}
